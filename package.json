{
    "name": "overseer",
    "version": "3.3.8",
    "description": "OVERSEER - ARK companion app with taming calculator, breeding, maps & more",
    "main": "electron/main.js",
    "scripts": {
        "start": "vite build && electron .",
        "dev": "vite build && electron .",
        "vite:build": "vite build",
        "build": "vite build && electron-builder",
        "mobile:build": "vite build && cap sync",
        "android:add": "cap add android",
        "android:sync": "vite build && cap sync android",
        "android:open": "cap open android",
        "android:run": "vite build && cap run android",
        "cloudflare:dev": "npx wrangler dev --config cloudflare/overseer-api/wrangler.toml",
        "cloudflare:migrate:local": "npx wrangler d1 migrations apply overseer_api --local --config cloudflare/overseer-api/wrangler.toml",
        "cloudflare:migrate": "npx wrangler d1 migrations apply overseer_api --remote --config cloudflare/overseer-api/wrangler.toml",
        "cloudflare:deploy": "npx wrangler deploy --config cloudflare/overseer-api/wrangler.toml"
    },
    "keywords": [
        "ark",
        "taming",
        "calculator",
        "dododex",
        "overlay"
    ],
    "author": {
        "name": "haylowof-pixel",
        "email": "contact@overseer.app"
    },
    "license": "ISC",
    "type": "commonjs",
    "build": {
        "appId": "com.overseer.app",
        "productName": "OVERSEER",
        "directories": {
            "output": "release"
        },
        "files": [
            "electron/**/*",
            "shell/**/*",
            "dist/**/*",
            "public/**/*"
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "public/icon.ico"
        },
        "linux": {
            "target": [
                "rpm"
            ],
            "icon": "public/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "createDesktopShortcut": "always",
            "createStartMenuShortcut": true,
            "shortcutName": "OVERSEER",
            "runAfterFinish": true,
            "include": "build/installer.nsh"
        },
        "publish": {
            "provider": "github",
            "owner": "haylowof-pixel",
            "repo": "overseer-companion"
        }
    },
    "devDependencies": {
        "electron": "^40.6.1",
        "electron-builder": "^26.8.1",
        "ffmpeg-static": "^5.3.0",
        "playwright": "^1.60.0",
        "rcedit": "^5.0.2",
        "sharp": "^0.34.5",
        "to-ico": "^1.1.5"
    },
    "dependencies": {
        "@capacitor/android": "^8.4.0",
        "@capacitor/app": "^8.1.0",
        "@capacitor/cli": "^8.4.0",
        "@capacitor/core": "^8.4.0",
        "@capacitor/splash-screen": "^8.0.1",
        "@capacitor/status-bar": "^8.0.2",
        "@supabase/supabase-js": "^2.106.2",
        "@vitejs/plugin-react": "^6.0.1",
        "electron-updater": "^6.8.3",
        "framer-motion": "^12.38.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tesseract.js": "^7.0.0",
        "three": "^0.184.0",
        "vite": "^8.0.1"
    }
}
